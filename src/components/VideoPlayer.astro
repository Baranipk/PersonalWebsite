---
// YouTube oynatıcı. Sayfa açılırken yalnızca kapak resmi yüklenir;
// iframe ancak oynat düğmesine ya da listeden bir videoya tıklanınca eklenir.
import { ui } from '../data/ui';
import {
  embedUrl,
  getPlaylistId,
  getYouTubeId,
  playlistEmbedUrl,
  posterUrl,
  thumbnailUrl,
} from '../lib/youtube';

interface Props {
  videos: { title: string; url: string }[];
  playlist?: string;
  // Oynatma listesinde YouTube küçük resmi olmadığı için proje kapağı kullanılır
  fallbackPoster: string;
  projectTitle: string;
}

const { videos, playlist, fallbackPoster, projectTitle } = Astro.props;

// Oynatıcıda gösterilecek öğeler: önce tek tek videolar, yoksa oynatma listesi
type Item = { title: string; embed: string; poster: string; thumbnail?: string };
let items: Item[] = videos.flatMap((video) => {
  const id = getYouTubeId(video.url);
  return id
    ? [{ title: video.title, embed: embedUrl(id), poster: posterUrl(id), thumbnail: thumbnailUrl(id) }]
    : [];
});
if (items.length === 0 && playlist) {
  const listId = getPlaylistId(playlist);
  if (listId) {
    items = [{ title: projectTitle, embed: playlistEmbedUrl(listId), poster: fallbackPoster }];
  }
}

const first = items[0];
---

{
  first && (
    <div class:list={['video-player', { 'has-list': items.length > 1 }]} data-video-player>
      <div class="main">
        <div class="stage" data-stage>
          <button
            type="button"
            class="poster"
            data-poster
            data-embed={first.embed}
            data-title={first.title}
            aria-label={`${ui.projects.play}: ${first.title}`}
          >
            <img src={first.poster} alt="" />
            <span class="play-icon" aria-hidden="true" />
          </button>
        </div>
        <p class="now-playing" data-now-playing>
          {first.title}
        </p>
      </div>

      {items.length > 1 && (
        <div class="list-wrap">
          <ol class="list" aria-label={ui.projects.videos}>
            {items.map((item, index) => (
              <li>
                <button
                  type="button"
                  data-item
                  data-embed={item.embed}
                  data-title={item.title}
                  aria-current={index === 0 ? 'true' : undefined}
                >
                  <img src={item.thumbnail} alt="" width="320" height="180" loading="lazy" />
                  <span>{item.title}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>
  )
}

<script>
  // Sayfadaki her oynatıcıyı çalışır hale getir
  for (const player of document.querySelectorAll<HTMLElement>('[data-video-player]')) {
    const stage = player.querySelector<HTMLElement>('[data-stage]')!;
    const nowPlaying = player.querySelector<HTMLElement>('[data-now-playing]')!;
    const items = player.querySelectorAll<HTMLButtonElement>('[data-item]');

    // Verilen videoyu oynatıcıya yükle ve başlat
    function play(embed: string, title: string, moveFocus: boolean) {
      const iframe = document.createElement('iframe');
      iframe.src = `${embed}${embed.includes('?') ? '&' : '?'}autoplay=1&rel=0`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      stage.replaceChildren(iframe);
      nowPlaying.textContent = title;
      for (const item of items) {
        if (item.dataset.embed === embed) item.setAttribute('aria-current', 'true');
        else item.removeAttribute('aria-current');
      }
      // Kapak düğmesi kaybolduğu için klavye odağını oynatıcıya taşı
      if (moveFocus) iframe.focus();
    }

    const poster = player.querySelector<HTMLButtonElement>('[data-poster]');
    poster?.addEventListener('click', () => play(poster.dataset.embed!, poster.dataset.title!, true));

    for (const item of items) {
      item.addEventListener('click', () => play(item.dataset.embed!, item.dataset.title!, false));
    }
  }
</script>

<style>
  .video-player {
    display: grid;
    gap: 1rem;
  }
  /* Geniş ekranda liste oynatıcının sağında, dar ekranda altında */
  @media (min-width: 60rem) {
    .video-player.has-list {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
    /* Liste, oynatıcının yüksekliğini aşarsa kendi içinde kaydırılır */
    .list-wrap {
      position: relative;
    }
    .list {
      position: absolute;
      inset: 0;
      overflow-y: auto;
    }
  }

  /* 16:9 alan */
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stage :global(iframe),
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .poster {
    padding: 0;
    cursor: pointer;
    background: #000;
  }
  .poster img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* hqdefault 4:3; siyah şeritler kırpılır */
  }
  .poster:focus-visible {
    outline-offset: -4px;
  }
  .play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4.5rem;
    height: 4.5rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.7);
    transition: background 0.15s;
  }
  .play-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 0.8rem 0 0.8rem 1.3rem;
    border-color: transparent transparent transparent #fff;
  }
  .poster:hover .play-icon,
  .poster:focus-visible .play-icon {
    background: var(--accent);
  }
  .now-playing {
    margin: 0.5rem 0 0;
    font-weight: 600;
  }

  .list {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list button {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.75rem;
    align-items: center;
    width: 100%;
    padding: 0.4rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    text-align: left;
    cursor: pointer;
  }
  .list button:hover {
    background: var(--surface);
  }
  .list button[aria-current='true'] {
    background: var(--surface);
    border-color: var(--accent);
  }
  .list img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: calc(var(--radius) / 2);
  }
</style>
