---
// İkonlu sosyal bağlantılar listesi (alt bilgi ve ana sayfa için)
import SocialIcon from './SocialIcon.astro';
import site from '../data/site.json';

interface Props {
  // E-postayı da listeye ekle
  withEmail?: boolean;
  size?: number;
}

const { withEmail = true, size = 20 } = Astro.props;

// Panelde liste boşaltılırsa alan dosyadan kalkar, bu yüzden "?? []"
const links = [
  ...(withEmail && site.email ? [{ label: 'Email', url: `mailto:${site.email}` }] : []),
  ...(site.socials ?? []),
];
---

<ul class="social-links">
  {
    links.map((link) => (
      <li>
        <a
          href={link.url}
          aria-label={link.label}
          title={link.label}
          {...(link.url.startsWith('mailto:') ? {} : { target: '_blank', rel: 'me noopener' })}
        >
          <SocialIcon label={link.label} url={link.url} size={size} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted);
    background: var(--surface);
    transition:
      color 0.15s,
      border-color 0.15s,
      transform 0.15s;
  }
  a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
</style>
