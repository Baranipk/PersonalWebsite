---
// Proje galerisi: küçük resim ızgarası. Tıklayınca görsel sayfadan ayrılmadan büyük açılır;
// ok tuşlarıyla gezilir, Esc ile kapanır. JavaScript yoksa görsel yeni sekmede açılır.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import BlurImage from './BlurImage.astro';
import { ui } from '../data/ui';

interface Props {
  items: { image: ImageMetadata; caption?: string }[];
  title: string;
}

const { items, title } = Astro.props;

// Her görselin büyük (en fazla 1920 px) sürümünü hazırla
const images = await Promise.all(
  items.map(async (item, index) => ({
    ...item,
    full: await getImage({ src: item.image, width: Math.min(1920, item.image.width) }),
    alt: item.caption ?? `${title} — ${index + 1}`,
  })),
);
---

<div class="gallery" data-gallery>
  <ul class="grid-gallery">
    {
      images.map((item, index) => (
        <li class="reveal">
          <figure>
            <a
              href={item.full.src}
              target="_blank"
              data-index={index}
              data-full={item.full.src}
              data-caption={item.caption ?? ''}
              data-alt={item.alt}
            >
              <BlurImage src={item.image} alt={item.alt} width={640} class="thumb" />
              <span class="zoom" aria-hidden="true">⤢</span>
            </a>
            {item.caption && <figcaption class="muted">{item.caption}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label={ui.projects.gallery} data-lightbox>
    <figure>
      <img alt="" data-lightbox-img />
      <figcaption>
        <span data-lightbox-caption></span>
        <span class="counter muted" data-lightbox-counter></span>
      </figcaption>
    </figure>
    <button class="nav prev" type="button" aria-label={ui.gallery.previous} data-prev>‹</button>
    <button class="nav next" type="button" aria-label={ui.gallery.next} data-next>›</button>
    <button class="close" type="button" aria-label={ui.gallery.close} data-close autofocus>✕</button>
  </dialog>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
      setUpGallery(gallery);
    }
  });

  function setUpGallery(gallery: HTMLElement) {
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;
    let current = 0;

    // index numaralı görseli göster (baştan/sondan taşarsa döner)
    function show(index: number) {
      current = (index + links.length) % links.length;
      const link = links[current];
      img.src = link.dataset.full!;
      img.alt = link.dataset.alt!;
      caption.textContent = link.dataset.caption!;
      counter.textContent = `${current + 1} / ${links.length}`;
    }

    for (const link of links) {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        show(Number(link.dataset.index));
        dialog.showModal();
      });
    }

    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());

    // Ok tuşlarıyla gezin (Esc'yi tarayıcı kendisi halleder)
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    // Görselin dışındaki karanlık alana tıklayınca kapat
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Kapanınca odak, en son açılan küçük resme döner
    dialog.addEventListener('close', () => links[current]?.focus());

    // Telefonda parmakla sağa/sola kaydırma
    let touchStartX = 0;
    dialog.addEventListener('touchstart', (event) => (touchStartX = event.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (event) => {
      const distance = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(distance) > 50) show(current + (distance < 0 ? 1 : -1));
    });

    // Tek görsel varsa ileri/geri düğmelerine gerek yok
    if (links.length < 2) {
      dialog.querySelectorAll<HTMLElement>('.nav').forEach((button) => (button.hidden = true));
    }
  }
</script>

<style>
  .grid-gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  figure {
    margin: 0;
  }
  a {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }
  a :global(.thumb) {
    aspect-ratio: 16 / 9;
  }
  a :global(.thumb img) {
    transition: transform 0.4s;
  }
  a:hover :global(.thumb img) {
    transform: scale(1.05);
  }
  .zoom {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgb(14 16 20 / 0.75);
    color: var(--text);
    opacity: 0;
    transition: opacity 0.2s;
  }
  a:hover .zoom,
  a:focus-visible .zoom {
    opacity: 1;
  }
  figcaption {
    font-size: 0.85rem;
    margin-top: 0.4rem;
  }

  /* Büyütme penceresi */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 3.5rem 4rem;
    border: 0;
    background: transparent;
    color: var(--text);
  }
  .lightbox::backdrop {
    background: rgb(5 6 8 / 0.92);
    backdrop-filter: blur(4px);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox figure {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    max-height: 100%;
  }
  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 9rem);
    width: auto;
    border-radius: var(--radius);
  }
  .lightbox figcaption {
    display: flex;
    gap: 1rem;
    font-size: 0.95rem;
    margin: 0;
  }
  .lightbox button {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .lightbox button[hidden] {
    display: none;
  }
  .prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .close {
    top: 1rem;
    right: 1rem;
    font-size: 1.1rem !important;
  }
  @media (max-width: 40rem) {
    .lightbox {
      padding: 4rem 0.5rem 5rem;
    }
    .prev,
    .next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
    .prev {
      left: calc(50% - 3.5rem);
    }
    .next {
      right: calc(50% - 3.5rem);
    }
  }
</style>
