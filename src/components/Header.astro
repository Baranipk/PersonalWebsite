---
// Üst menü: kaydırırken üstte kalır; telefonda bir düğmeyle açılır
import Monogram from './Monogram.astro';
import site from '../data/site.json';
import { ui } from '../data/ui';

const links = [
  { href: '/', label: ui.nav.home },
  { href: '/projects/', label: ui.nav.projects },
  { href: '/blog/', label: ui.nav.blog },
  { href: '/about/', label: ui.nav.about },
];

// Bulunulan sayfanın menü bağlantısını işaretle
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header" data-header>
  <div class="inner">
    <a class="brand" href="/">
      <Monogram />
      <span>{site.name}</span>
    </a>

    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-button
    >
      <span class="bars" aria-hidden="true"></span>
      <span class="visually-hidden">{ui.nav.menu}</span>
    </button>

    <nav id="site-nav" aria-label="Main" data-menu>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Sayfa her açıldığında (sayfa geçişlerinden sonra da) menüyü hazırla
  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    if (!header || !button) return;

    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      header.classList.toggle('menu-open', open);
    });

    // Esc ile kapat
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('menu-open')) {
        button.setAttribute('aria-expanded', 'false');
        header.classList.remove('menu-open');
        button.focus();
      }
    });

    updateHeaderBackground();
  });

  // Kaydırınca menünün arkasına zemin ver. Pencere sayfa geçişlerinde değişmediği için
  // dinleyici bir kez eklenir ve o anki menüyü bulur.
  function updateHeaderBackground() {
    document.querySelector('[data-header]')?.classList.toggle('scrolled', window.scrollY > 8);
  }
  window.addEventListener('scroll', updateHeaderBackground, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .site-header.scrolled,
  .site-header.menu-open {
    background: rgb(14 16 20 / 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.75rem 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: block;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  nav a:hover {
    color: var(--text);
    background: var(--surface);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  /* Menü düğmesi yalnızca dar ekranda görünür */
  .menu-button {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  /* Üç çizgili "hamburger" ikonu; açılınca X'e döner */
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 18px;
    height: 2px;
    margin: 0 auto;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.2s;
  }
  .bars {
    position: relative;
  }
  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .bars::before {
    top: -6px;
  }
  .bars::after {
    top: 6px;
  }
  .menu-open .bars {
    background: transparent;
  }
  .menu-open .bars::before {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-open .bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 40rem) {
    .menu-button {
      display: block;
    }
    nav {
      display: none;
      width: 100%;
    }
    .menu-open nav {
      display: block;
    }
    ul {
      flex-direction: column;
      padding: 0.5rem 0 0.75rem;
    }
    nav a {
      padding: 0.75rem 1rem;
      border-radius: var(--radius);
    }
  }
</style>
