---
// Sosyal bağlantı ikonu. Bağlantının etiketine ya da adresine bakarak doğru ikonu seçer.
// Marka ikonları simple-icons paketinden gelir (CC0 lisanslı); tanınmayanlar için genel bir bağlantı ikonu çizilir.
import {
  siArtstation,
  siBluesky,
  siDiscord,
  siGithub,
  siInstagram,
  siItchdotio,
  siSteam,
  siX,
  siYoutube,
} from 'simple-icons';

interface Props {
  label: string;
  url: string;
  size?: number;
}

const { label, url, size = 20 } = Astro.props;
const key = `${label} ${url}`.toLowerCase();

// Hangi kelime geçiyorsa o ikon (sıra önemli değil)
const brands = [
  { match: ['github'], icon: siGithub },
  { match: ['itch'], icon: siItchdotio },
  { match: ['youtube', 'youtu.be'], icon: siYoutube },
  { match: ['twitter', 'x.com'], icon: siX },
  { match: ['bluesky', 'bsky'], icon: siBluesky },
  { match: ['artstation'], icon: siArtstation },
  { match: ['steam'], icon: siSteam },
  { match: ['discord'], icon: siDiscord },
  { match: ['instagram'], icon: siInstagram },
];
const brand = brands.find((b) => b.match.some((word) => key.includes(word)));
const isLinkedIn = key.includes('linkedin');
const isEmail = url.startsWith('mailto:');
---

<svg
  class="social-icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {
    brand ? (
      <path d={brand.icon.path} />
    ) : isLinkedIn ? (
      // LinkedIn simple-icons'ta yok; basit bir "in" kutusu
      <>
        <rect x="2" y="2" width="20" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
        <circle cx="7.5" cy="7.6" r="1.5" />
        <rect x="6" y="10" width="3" height="8" />
        <path d="M11 10h2.8v1.2c.5-.8 1.5-1.5 2.9-1.5 2.4 0 3.3 1.5 3.3 4V18h-3v-3.9c0-1.1-.3-1.8-1.3-1.8s-1.7.8-1.7 1.9V18H11z" />
      </>
    ) : isEmail ? (
      <path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3zM5.6 7 12 11.2 18.4 7z" />
    ) : (
      // Genel bağlantı ikonu
      <path d="M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a3 3 0 1 1 4.2 4.2l-2 2a1 1 0 0 1-1.4-1.4l2-2a1 1 0 1 0-1.4-1.4L12 13.4a1 1 0 0 1-1.4 0zm2.8-2.8a1 1 0 0 1 0 1.4L9.9 15.5a3 3 0 1 1-4.2-4.2l2-2a1 1 0 0 1 1.4 1.4l-2 2a1 1 0 1 0 1.4 1.4L12 10.6a1 1 0 0 1 1.4 0z" />
    )
  }
</svg>

<style>
  .social-icon {
    flex-shrink: 0;
    display: block;
  }
</style>
