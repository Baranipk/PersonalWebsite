---
// Blog listesindeki tek yazı: başlık, tarih, okuma süresi, özet, etiketler
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { formatDate, readingTime } from '../lib/format';
import { ui } from '../data/ui';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
---

<article class="post-item">
  <h3>
    <a href={`/blog/${post.id}/`}>{title}</a>
  </h3>
  <p class="meta muted">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    · {readingTime(post.body)} {ui.blog.minRead}
    {draft && <span class="draft-badge">{ui.blog.draft}</span>}
  </p>
  <p class="description">{description}</p>
  <TagList tags={tags} />
</article>

<style>
  .post-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  h3 {
    margin: 0 0 0.25rem;
  }
  .meta {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }
  .description {
    margin: 0 0 0.75rem;
  }
</style>
