---
// Görsel yüklenene kadar arkasında aynı görselin çok küçük, bulanık bir hali görünür.
// Küçük hali yaklaşık 300 bayt; boş kutu yerine renkli bir önizleme sağlar.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  // Sayfa geçişinde bu görselin diğer sayfadaki karşılığına "akması" için ortak ad
  transitionName?: string;
}

const { src, alt, width, class: className, loading = 'lazy', transitionName } = Astro.props;
const tiny = await getImage({ src, width: 24, quality: 40, format: 'webp' });
---

<div
  class:list={['blur-image', className]}
  style={`--blur-src: url(${tiny.src})`}
  transition:name={transitionName}
>
  <Image src={src} alt={alt} width={width} loading={loading} />
</div>

<style>
  .blur-image {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }
  .blur-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--blur-src) center / cover no-repeat;
    filter: blur(14px);
    transform: scale(1.15);
  }
  .blur-image :global(img) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
