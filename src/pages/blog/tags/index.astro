---
// Tüm etiketler ve her birinde kaç yazı olduğu
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ui } from '../../../data/ui';
import { getTags } from '../../../lib/content';

const tags = await getTags();
---

<BaseLayout title={ui.blog.allTags}>
  <p><a href="/blog/">{ui.blog.backToBlog}</a></p>
  <h1>{ui.blog.allTags}</h1>
  <ul class="tag-index">
    {
      tags.map((tag) => (
        <li>
          <a href={`/blog/tags/${tag.slug}/`}>#{tag.name}</a>
          <span class="muted">({tag.count})</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .tag-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 0;
    list-style: none;
  }
</style>
