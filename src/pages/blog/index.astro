---
// Blog listesi: tam metin değil, özet
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../../components/PostItem.astro';
import { ui } from '../../data/ui';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title={ui.blog.title} description={ui.blog.intro}>
  <h1>{ui.blog.title}</h1>
  <p class="muted">{ui.blog.intro}</p>
  <p class="links">
    <a href="/blog/tags/">{ui.blog.allTags}</a>
    <!-- RSS bir sayfa değil, dosya: sayfa geçişi yerine normal açılsın -->
    <a href="/rss.xml" data-astro-reload>{ui.blog.rss}</a>
  </p>
  <div class="post-list">
    {
      posts.length === 0 ? (
        <p>{ui.blog.empty}</p>
      ) : (
        posts.map((post) => (
          <div class="reveal">
            <PostItem post={post} />
          </div>
        ))
      )
    }
  </div>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.25rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .links {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9rem;
  }
  .post-list {
    max-width: 70ch;
  }
</style>
