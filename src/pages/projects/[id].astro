---
// Tek proje sayfası: video oynatıcı (yoksa kapak), açıklama, bilgi kutusu, galeri
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlurImage from '../../components/BlurImage.astro';
import Gallery from '../../components/Gallery.astro';
import PrevNext from '../../components/PrevNext.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { ui } from '../../data/ui';
import { getProjects } from '../../lib/content';

// Her proje için bir sayfa üret; önceki ve sonraki projeyi de ver
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: { project, prev: projects[index - 1], next: projects[index + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { title, summary, cover, links, gallery, videos, playlist, draft } = project.data;
const { Content } = await render(project);

// Video ya da oynatma listesi varsa kapak yerine oynatıcı gösterilir
const hasVideo = videos.length > 0 || Boolean(playlist);
const posterImage = await getImage({ src: cover, width: 1280 });

// Bilgi kutusundaki satırlar (boş olanlar gösterilmez)
const info = [
  [ui.projects.info.year, project.data.year],
  [ui.projects.info.role, project.data.role],
  [ui.projects.info.engine, project.data.engine],
  [ui.projects.info.duration, project.data.duration],
  [ui.projects.info.team, project.data.team],
  [ui.projects.info.platform, project.data.platform],
].filter(([, value]) => value);
---

<BaseLayout title={title} description={summary} image={cover}>
  <article>
    <p><a href="/projects/">{ui.projects.backToProjects}</a></p>
    <h1>
      {title}
      {draft && <span class="draft-badge">{ui.blog.draft}</span>}
    </h1>
    <p class="summary muted">{summary}</p>

    <!-- Proje kartındaki kapak, sayfa geçişinde buraya "akar" -->
    <div class="media" transition:name={`cover-${project.id}`}>
      {
        hasVideo ? (
          <VideoPlayer
            videos={videos}
            playlist={playlist}
            fallbackPoster={posterImage.src}
            projectTitle={title}
          />
        ) : (
          <BlurImage src={cover} alt="" width={1600} class="cover" loading="eager" />
        )
      }
    </div>

    <div class="layout">
      <div class="prose">
        <Content />
      </div>

      <aside>
        <div class="sticky">
          <dl class="info">
            {
              info.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))
            }
          </dl>
          {
            links.length > 0 && (
              <ul class="links" aria-label={ui.projects.links}>
                {links.map((link) => (
                  <li>
                    <a class="button ghost" href={link.url} target="_blank" rel="noopener">
                      <SocialIcon label={link.label} url={link.url} size={18} />
                      {link.label}
                      <span class="arrow" aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </aside>
    </div>

    {
      gallery.length > 0 && (
        <section class="gallery-section">
          <h2>{ui.projects.gallery}</h2>
          <Gallery items={gallery} title={title} />
        </section>
      )
    }

    <PrevNext
      prev={prev && { href: `/projects/${prev.id}/`, title: prev.data.title, label: ui.projects.previous }}
      next={next && { href: `/projects/${next.id}/`, title: next.data.title, label: ui.projects.next }}
    />
  </article>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.25rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .summary {
    font-size: 1.125rem;
    margin-top: 0;
  }
  .media {
    margin: 1.5rem 0 2.5rem;
  }
  .media :global(.cover) {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
  }
  /* Geniş ekranda açıklama solda, bilgi kutusu sağda; dar ekranda bilgi kutusu üstte */
  .layout {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  aside {
    order: -1;
  }
  /* Bu blok yukarıdaki "order" kuralından sonra gelmeli, yoksa ezilir */
  @media (min-width: 52rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
    aside {
      order: 2;
    }
    /* Metin kaydırılırken bilgi kutusu görünür kalır */
    .sticky {
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
    }
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }
  .info {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }
  dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  .links {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .links .button {
    width: 100%;
    border-radius: var(--radius);
  }
  .arrow {
    margin-left: auto;
  }
  .gallery-section {
    margin-top: 4rem;
  }
</style>
