---
// Tek proje sayfası: video oynatıcı (yoksa kapak), açıklama, bilgi kutusu, galeri
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { ui } from '../../data/ui';
import { getProjects } from '../../lib/content';

// Her proje için bir sayfa üret
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, cover, links, gallery, videos, playlist, draft } = project.data;
const { Content } = await render(project);

// Video ya da oynatma listesi varsa kapak yerine oynatıcı gösterilir
const hasVideo = videos.length > 0 || Boolean(playlist);
const posterImage = await getImage({ src: cover, width: 1280 });

// Bilgi kutusundaki satırlar (boş olanlar gösterilmez)
const info = [
  [ui.projects.info.year, project.data.year],
  [ui.projects.info.role, project.data.role],
  [ui.projects.info.engine, project.data.engine],
  [ui.projects.info.duration, project.data.duration],
  [ui.projects.info.team, project.data.team],
  [ui.projects.info.platform, project.data.platform],
].filter(([, value]) => value);
---

<BaseLayout title={title} description={summary}>
  <article>
    <p><a href="/projects/">{ui.projects.backToProjects}</a></p>
    <h1>
      {title}
      {draft && <span class="draft-badge">{ui.blog.draft}</span>}
    </h1>
    <p class="summary muted">{summary}</p>

    <div class="media">
      {
        hasVideo ? (
          <VideoPlayer
            videos={videos}
            playlist={playlist}
            fallbackPoster={posterImage.src}
            projectTitle={title}
          />
        ) : (
          <Image src={cover} alt="" width={1600} class="cover" />
        )
      }
    </div>

    <div class="layout">
      <div class="prose">
        <Content />
      </div>

      <aside>
        <dl class="info">
          {
            info.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
        {
          links.length > 0 && (
            <ul class="links" aria-label={ui.projects.links}>
              {links.map((link) => (
                <li>
                  <a class="button" href={link.url} target="_blank" rel="noopener">
                    {link.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </aside>
    </div>

    {
      gallery.length > 0 && (
        <section>
          <h2>{ui.projects.gallery}</h2>
          <Gallery items={gallery} title={title} />
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.25rem;
  }
  .summary {
    font-size: 1.125rem;
    margin-top: 0;
  }
  .media {
    margin: 1.5rem 0 2rem;
  }
  .cover {
    width: 100%;
    border-radius: var(--radius);
  }
  /* Geniş ekranda açıklama solda, bilgi kutusu sağda; dar ekranda bilgi kutusu üstte */
  .layout {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }
  aside {
    order: -1;
    align-self: start;
  }
  /* Bu blok yukarıdaki "order" kuralından sonra gelmeli, yoksa ezilir */
  @media (min-width: 52rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
    aside {
      order: 2;
    }
  }
  .prose > :first-child {
    margin-top: 0;
  }
  .info {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .button {
    display: block;
    text-align: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
  }
  .button:hover {
    background: var(--accent);
    color: var(--bg);
  }
  section {
    margin-top: 3rem;
  }
</style>
