---
// Ana sayfa: giriş, öne çıkan projeler, son yazılar
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import { ui } from '../data/ui';
import { getPosts, getProjects } from '../lib/content';

const allProjects = await getProjects();
const projects = allProjects.slice(0, 3);
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <Hero slot="hero" featured={allProjects[0]} />

  <section>
    <div class="section-head">
      <h2>{ui.home.featuredProjects}</h2>
      <a href="/projects/">{ui.home.allProjects}</a>
    </div>
    <ul class="grid">
      {
        projects.map((project) => (
          <li class="reveal">
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
  </section>

  {
    posts.length > 0 && (
      <section>
        <div class="section-head">
          <h2>{ui.home.latestPosts}</h2>
          <a href="/blog/">{ui.home.allPosts}</a>
        </div>
        <div class="posts">
          {posts.map((post) => (
            <div class="reveal">
              <PostItem post={post} />
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  section + section {
    margin-top: 4rem;
  }
  .posts {
    max-width: 70ch;
  }
</style>
