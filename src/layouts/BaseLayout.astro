---
// Tüm sayfaların ortak çerçevesi: <head>, menü, alt bilgi
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { ui } from '../data/ui';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.intro } = Astro.props;
// Sekme başlığı: "Sayfa — Ad" ya da yalnızca "Ad — Unvan"
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;
---

<!doctype html>
<html lang={ui.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
