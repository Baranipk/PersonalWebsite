---
// Tüm sayfaların ortak çerçevesi: <head>, menü, alt bilgi
// Yazı tipleri siteyle birlikte sunulur (dış sunucudan yüklenmez)
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import site from '../data/site.json';
import { ui } from '../data/ui';

interface Props {
  title?: string;
  description?: string;
  // Paylaşım kartında görünecek görsel (yoksa varsayılan görsel)
  image?: ImageMetadata;
  // Blog yazısı gibi sayfalarda "article"
  type?: 'website' | 'article';
  // Sayfanın üstünde okuma ilerleme çubuğu
  readingProgress?: boolean;
}

const { title, description = site.intro, image, type = 'website', readingProgress = false } = Astro.props;
// Sekme başlığı: "Sayfa — Ad" ya da yalnızca "Ad — Unvan"
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;

// Paylaşım kartı (LinkedIn, Discord, WhatsApp...) için tam adresler
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImagePath = image
  ? (await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : '/og-default.png';
const ogImage = new URL(ogImagePath, Astro.site);
---

<!doctype html>
<html lang={ui.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e1014" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — ${ui.blog.title}`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Paylaşım önizleme kartı -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Sayfalar arası yumuşak geçiş -->
    <ClientRouter />
  </head>
  <body>
    {readingProgress && <div class="reading-progress" aria-hidden="true"></div>}
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <Header />
    <!-- Sayfanın tam genişliğini kaplayan bölüm (ana sayfa girişi gibi) -->
    <slot name="hero" />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
